# --- macOS ---
.DS_Store

# --- Editor / tooling ---
.vscode/
.idea/
.claude/
*.log
*.swp

# --- Environment ---
.env
.env.local

# --- Build artefacts (none yet, future-proof) ---
node_modules/
dist/
.cache/

# --- Source media ---
# Every image the site serves is a committed .webp under assets/images/.
# Full-resolution camera originals are NOT kept in the repo — if you need to
# re-export an image at a different size, start from the original photo.
assets/images/_originals/
assets/images/**/*.psd
assets/images/**/*.tif
assets/images/**/*.tiff
